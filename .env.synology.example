# .env.synology.example — template for the production .env on Synology.
# Copy to .env.synology, fill in real values, then run:
#   scripts/sync-env.sh
#
# This file IS committed to git (it has no real secrets).
# .env.synology is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=myassistant
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=myassistant

# ── Shared auth token (http-server ↔ chatbot-server ↔ scheduler) ─────────────
AUTH_TOKEN=CHANGE_ME

# ── Chatbot server ────────────────────────────────────────────────────────────
BEDROCK_API_KEY=CHANGE_ME
# Optional: minimum raw user turns kept before summarization. Default: 5
# CHATBOT_MIN_RAW_TURNS=5

# ── Scheduler (news polling) ──────────────────────────────────────────────────
NEWSAPIAI_KEY=CHANGE_ME
# IANA timezone for cron schedule interpretation. Default: UTC
SCHEDULER_TIMEZONE=America/Los_Angeles
# Web search provider: "duckduckgo" (free, no key) or "brave" (requires BRAVE_API_KEY)
WEB_SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=

# ── Cloudflare tunnel ─────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# ── GitHub self-hosted runner ─────────────────────────────────────────────────
# Personal Access Token with repo scope — used by the runner to register with GitHub
GITHUB_PAT=CHANGE_ME
