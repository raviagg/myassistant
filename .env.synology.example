# .env.synology.example — template for the production .env on Synology.
# Copy to .env.synology, fill in real values, then run:
#   scripts/sync-env.sh
#
# This file IS committed to git (it has no real secrets).
# .env.synology is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=myassistant
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=myassistant

# ── Shared auth token (http-server ↔ chatbot-server ↔ scheduler) ─────────────
AUTH_TOKEN=CHANGE_ME

# ── Chatbot server ────────────────────────────────────────────────────────────
BEDROCK_API_KEY=CHANGE_ME
# Optional: minimum raw user turns kept before summarization. Default: 5
# CHATBOT_MIN_RAW_TURNS=5

# ── Scheduler (news polling) ──────────────────────────────────────────────────
NEWSAPIAI_KEY=CHANGE_ME
# IANA timezone for cron schedule interpretation. Default: UTC
SCHEDULER_TIMEZONE=America/Los_Angeles
# Web search provider: "duckduckgo" (free, no key) or "brave" (requires BRAVE_API_KEY)
WEB_SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=

# ── News ranking tuning (all optional — defaults shown) ───────────────────────
# Normalisation caps
# NEWS_ARTICLE_CAP=200
# NEWS_SOCIAL_CAP=10000
# NEWS_CATEGORY_WEIGHT_CAP=100
# Phase-1 weights (must sum to 1.0)
# NEWS_P1_ARTICLE_WEIGHT=0.50
# NEWS_P1_SOCIAL_WEIGHT=0.30
# NEWS_P1_CATEGORY_WEIGHT=0.20
# Phase-2 weights (must sum to 1.0)
# NEWS_P2_ARTICLE_WEIGHT=0.60
# NEWS_P2_SOCIAL_WEIGHT=0.40
# Result limits
# NEWS_TOP_PER_CATEGORY=3
# NEWS_MAX_EVENTS=20
# NEWS_ARTICLES_PER_EVENT=3
# NEWS_LOG_PER_CATEGORY=15

# ── Cloudflare tunnel ─────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# ── Grafana Creds for Logging/Observability ───────────────────────
GRAFANA_PASSWORD=CHANGE_ME

# ── Plaid (banking integration) ───────────────────────────────────────────────
PLAID_CLIENT_ID=CHANGE_ME
PLAID_SECRET=CHANGE_ME
PLAID_ENV=sandbox

# ── Embedding service (set if running chatbot on non-default port/host) ────────
# EMBED_SERVICE_URL=http://chatbot:8000

# ── GitHub self-hosted runner ─────────────────────────────────────────────────
# Personal Access Token with repo scope — used by the runner to register with GitHub
GITHUB_PAT=CHANGE_ME
