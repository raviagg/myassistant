# Copy this file to .env and fill in real values.
# .env is gitignored; .env.tmp is the committed template.

# ── Scala HTTP server ─────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
AUTH_TOKEN=dev-token-change-me-in-production
FILE_STORAGE_BASE_PATH=/tmp/myassistant/files

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/myassistant
DB_USER=myassistant
DB_PASSWORD=changeme
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ── Chatbot server ────────────────────────────────────────────────────────────
CHATBOT_PORT=8000
BEDROCK_API_KEY=
CHATBOT_HTTP_URL=http://localhost:8080
CHATBOT_AUTH_TOKEN=dev-token-change-me-in-production
CORS_ORIGIN=http://localhost:5173

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173

# ── Scheduler (news polling) ──────────────────────────────────────────────────
# SCHEDULER_TIMEZONE: IANA timezone name for cron expression interpretation.
#                     Cron times are in this timezone. Default: UTC.
#                     Example: America/Los_Angeles, America/New_York, Europe/London
SCHEDULER_TIMEZONE=America/Los_Angeles

# NEWS_SOURCE_PROVIDER: "newsapi" (default) requires NEWSAPI_KEY from newsapi.org
#                       "rss"     uses free RSS feeds — no key needed, set NEWSAPI_KEY=
NEWS_SOURCE_PROVIDER=newsapi
NEWSAPI_KEY=

# NEWSAPI_USE_EVERYTHING: "true" uses /v2/everything (more results, date filtering, recommended).
#                         "false" uses /v2/top-headlines (fewer sources, no date range).
NEWSAPI_USE_EVERYTHING=true

# WEB_SEARCH_PROVIDER: "duckduckgo" (default) is free, no key needed
#                      "brave"      requires a Brave Search API key from brave.com/search/api
#                      Set WEB_SEARCH_PROVIDER=brave and fill in BRAVE_API_KEY to switch.
WEB_SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=
