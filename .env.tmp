# Copy this file to .env and fill in real values.
# .env is gitignored; .env.tmp is the committed template.

# ── Scala HTTP server ─────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
AUTH_TOKEN=dev-token-change-me-in-production
FILE_STORAGE_BASE_PATH=/tmp/myassistant/files

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/myassistant
DB_USER=myassistant
DB_PASSWORD=changeme
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ── Chatbot server ────────────────────────────────────────────────────────────
CHATBOT_PORT=8000
BEDROCK_API_KEY=
CHATBOT_HTTP_URL=http://localhost:8080
CHATBOT_AUTH_TOKEN=dev-token-change-me-in-production
CORS_ORIGIN=http://localhost:5173

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173

# ── Scheduler (news polling) ──────────────────────────────────────────────────
# SCHEDULER_TIMEZONE: IANA timezone name for cron expression interpretation.
#                     Cron times are in this timezone. Default: UTC.
#                     Example: America/Los_Angeles, America/New_York, Europe/London
SCHEDULER_TIMEZONE=America/Los_Angeles

# NEWSAPIAI_KEY: API key from newsapi.ai (EventRegistry). Get yours at https://newsapi.ai/dashboard
# Set news preferences via chat: tell the agent which categories/sources you want.
NEWSAPIAI_KEY=

# ── News ranking tuning (all optional — defaults shown) ───────────────────────
# Normalisation caps (raw values from API are hard-clamped before scoring)
# NEWS_ARTICLE_CAP=200          # article count is clamped to this before log normalisation
# NEWS_SOCIAL_CAP=10000         # social score is clamped to this before linear normalisation
# NEWS_CATEGORY_WEIGHT_CAP=100  # category weight (from API response) is clamped to this before normalisation

# Phase-1 weights: per-category scoring (must sum to 1.0 for sensible results)
# NEWS_P1_ARTICLE_WEIGHT=0.50
# NEWS_P1_SOCIAL_WEIGHT=0.30
# NEWS_P1_CATEGORY_WEIGHT=0.20

# Phase-2 weights: cross-category re-scoring (must sum to 1.0)
# NEWS_P2_ARTICLE_WEIGHT=0.60
# NEWS_P2_SOCIAL_WEIGHT=0.40

# Result limits
# NEWS_TOP_PER_CATEGORY=3       # events kept per category after Phase-1
# NEWS_MAX_EVENTS=9             # total events kept after Phase-2
# NEWS_ARTICLES_PER_EVENT=3     # top articles fetched per event

# Logging
# NEWS_LOG_PER_CATEGORY=15      # max events logged with rank detail per category (0 = disabled)

# WEB_SEARCH_PROVIDER: "duckduckgo" (default) is free, no key needed
#                      "brave"      requires a Brave Search API key from brave.com/search/api
#                      Set WEB_SEARCH_PROVIDER=brave and fill in BRAVE_API_KEY to switch.
WEB_SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
# Grafana admin password. Default: admin (change in production)
GRAFANA_PASSWORD=admin
